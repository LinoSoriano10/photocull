# Normalise line endings: LF in the repo, regardless of the OS checking out.
* text=auto eol=lf

# Treat committed test images as binary so git never mangles them.
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.heic binary

# Test fixtures are compared byte for byte, and some of them are deliberately
# byte-identical pairs. Line-ending normalisation would change their SHA-256
# between a Windows checkout and a Linux one, so a test that passes locally
# would fail in CI for a reason nobody would guess from the failure.
testdata/** -text
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
